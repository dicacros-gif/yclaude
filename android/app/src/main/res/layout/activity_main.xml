<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0d0d0d">

    <!-- Top bar: title + mode toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="#161616">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="YT Meta"
            android:textColor="#ff4d4d"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/modeGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShorts"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shorts"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLong"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="롱폼"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:text="키워드를 입력하고 생성을 누르세요"
        android:textColor="#9aa0a6"
        android:textSize="12sp"
        android:background="#111111" />

    <ScrollView
        android:id="@+id/form"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Keywords -->
            <TextView style="@style/YLabel" android:text="키워드 / 콘셉트" />
            <EditText
                android:id="@+id/keywordsInput"
                style="@style/YInput"
                android:minLines="2"
                android:hint="예) 여름 밤 드라이브 신스웨이브 댄스" />

            <!-- Song title -->
            <TextView style="@style/YLabel" android:text="노래 제목 (선택)" />
            <EditText
                android:id="@+id/songInput"
                style="@style/YInput"
                android:singleLine="true"
                android:hint="예) Midnight Bloom" />

            <!-- Lyrics -->
            <TextView style="@style/YLabel" android:text="가사 (선택 · 설명 중단에 포함)" />
            <EditText
                android:id="@+id/lyricsInput"
                style="@style/YInput"
                android:minLines="3"
                android:maxLines="8"
                android:hint="가사를 붙여넣으면 설명에 자동 포함됩니다" />

            <!-- Timestamp duration (long form only) -->
            <LinearLayout
                android:id="@+id/tsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView style="@style/YLabel"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="영상 길이" />

                <EditText
                    android:id="@+id/hoursInput"
                    style="@style/YInput"
                    android:layout_width="64dp"
                    android:inputType="number"
                    android:singleLine="true"
                    android:gravity="center"
                    android:text="0"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="시간"
                    android:textColor="#9aa0a6"
                    android:layout_marginStart="4dp" />

                <EditText
                    android:id="@+id/minutesInput"
                    style="@style/YInput"
                    android:layout_width="64dp"
                    android:inputType="number"
                    android:singleLine="true"
                    android:gravity="center"
                    android:text="3"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="분"
                    android:textColor="#9aa0a6"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Generate / Regenerate -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnGenerate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="생성" />

                <Button
                    android:id="@+id/btnRegen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="↻ 재생성" />
            </LinearLayout>

            <!-- Title output -->
            <LinearLayout style="@style/YOutHeader">
                <TextView style="@style/YOutTitle" android:text="제목 Title" />
                <Button
                    android:id="@+id/btnCopyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:textSize="12sp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="복사" />
            </LinearLayout>
            <EditText
                android:id="@+id/titleOut"
                style="@style/YInput"
                android:minLines="2"
                android:textColor="#ffd54f"
                android:hint="제목이 여기에 생성됩니다" />

            <!-- Description output -->
            <LinearLayout style="@style/YOutHeader">
                <TextView style="@style/YOutTitle" android:text="설명 Description" />
                <Button
                    android:id="@+id/btnCopyDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:textSize="12sp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="복사" />
            </LinearLayout>
            <EditText
                android:id="@+id/descOut"
                style="@style/YInput"
                android:minLines="6"
                android:maxLines="16"
                android:textColor="#e0e0e0"
                android:hint="설명이 여기에 생성됩니다" />

            <!-- Tags output -->
            <LinearLayout style="@style/YOutHeader">
                <TextView style="@style/YOutTitle" android:text="태그 Tags" />
                <Button
                    android:id="@+id/btnCopyTags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:textSize="12sp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="복사" />
            </LinearLayout>
            <EditText
                android:id="@+id/tagsOut"
                style="@style/YInput"
                android:minLines="2"
                android:textColor="#80d8ff"
                android:hint="태그가 여기에 생성됩니다" />

            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
